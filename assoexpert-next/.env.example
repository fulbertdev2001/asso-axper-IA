# ==============================================================================
# AssoExpert IA — Variables d'environnement (commentées)
# ⚠️ RÈGLE CRITIQUE (§3.8) : Aucune clé secrète ne doit JAMAIS porter le préfixe
# NEXT_PUBLIC_. Seules les URLs publiques et identifiants publics d'analytics
# peuvent utiliser NEXT_PUBLIC_.
# ==============================================================================

# --- Base de données PostgreSQL (Neon Postgres / Docker local / Coolify) ---
# Exemple Neon : postgresql://neondb_owner:password@ep-xxx-pooler.eu-central-1.aws.neon.tech/neondb?sslmode=require
DATABASE_URL="postgresql://neondb_owner:VOTRE_MOT_DE_PASSE@ep-votre-instance.eu-central-1.aws.neon.tech/neondb?sslmode=require"

# --- Cache & Rate Limiting (Valkey / Redis en conteneur) ---
VALKEY_URL="redis://localhost:6379"
RATE_LIMIT_REQUESTS_PER_MINUTE="10"

# --- Authentification (Better Auth - sessions en base) ---
BETTER_AUTH_SECRET="change_me_in_production_min_32_chars_random_hex"
BETTER_AUTH_URL="http://localhost:3000"
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# --- CMS & Back-office (Payload 3 - schéma Postgres séparé `payload`) ---
PAYLOAD_SECRET="change_me_payload_secret_min_32_chars"

# --- Intelligence Artificielle (Anthropic SDK - Appel serveur uniquement) ---
# Modèles configurés en base : claude-haiku-4-5-20251001 et claude-sonnet-5
ANTHROPIC_API_KEY="sk-ant-api03-..."

# --- Paiement & Abonnements (Stripe Billing + Customer Portal) ---
STRIPE_SECRET_KEY="sk_test_..."
STRIPE_WEBHOOK_SECRET="whsec_..."
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY="pk_test_..."

# --- Envoi d'emails transactionnels (SMTP interchangeable : Brevo / Resend) ---
SMTP_HOST="smtp-relay.brevo.com"
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""
MAIL_FROM="AssoExpert IA <noreply@assoexpert.fr>"
EXPERT_NOTIFICATION_EMAIL="contact@cabinet-mae.fr"

# --- Stockage Fichiers & Sauvegardes S3 (OVH Object Storage / Scaleway France) ---
S3_ENDPOINT="https://s3.gra.io.cloud.ovh.net"
S3_REGION="gra"
S3_BUCKET="assoexpert-storage"
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""
BACKUP_ENCRYPTION_KEY="change_me_32_byte_passphrase_for_pg_dump_gpg"
BACKUP_RETENTION_DAYS="30"

# --- Monitoring d'erreurs (GlitchTip auto-hébergé - scrubbing activé) ---
GLITCHTIP_DSN=""
NEXT_PUBLIC_GLITCHTIP_DSN=""

# --- Analytics Produit sans cookie (Umami auto-hébergé) ---
NEXT_PUBLIC_UMAMI_URL="http://localhost:3001"
NEXT_PUBLIC_UMAMI_WEBSITE_ID="00000000-0000-0000-0000-000000000000"

# --- URL publique du site ---
# Utilisée pour construire les liens envoyés par email (magic link, réinitialisation) :
# OBLIGATOIRE en production (sinon l'en-tête Host de la requête n'est jamais utilisé pour les emails).
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# --- Seed de démonstration (npm run db:seed) — jamais de mot de passe dans le repo ---
SEED_ADMIN_PASSWORD=""
SEED_DEMO_PASSWORD=""

